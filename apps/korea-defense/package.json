{
  "name": "@dashjie/korea-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "决战朝鲜：塔防——温井防御战垂直切片",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
